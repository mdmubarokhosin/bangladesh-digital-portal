# Public site URL (set to your Cloudflare Pages domain in production)
# Used for SEO metadata, OpenGraph tags, and sitemap generation
NEXT_PUBLIC_SITE_URL="https://bangladesh-digital-portal.pages.dev"

# Source reference (the official Bangladesh National Portal)
SOURCE_BASE_URL="https://bangladesh.gov.bd/"

# ─── LOCAL DEVELOPMENT ONLY (optional) ───
# The static export build does NOT use a database — all data is bundled in src/lib/bd/static-data.ts
# These variables are only needed if you want to run Prisma + SQLite locally for development.

# Database (SQLite for local dev)
# DATABASE_URL="file:./db/custom.db"

# AI API key (only needed for server-side LLM in dev mode — static export uses client-side smart search)
# AI_API_KEY=""
